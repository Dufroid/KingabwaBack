PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kingabwa_awards
JWT_SECRET=change_this_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOADS_BASE_URL=http://localhost:5000
NODE_ENV=development

# Cloudinary image hosting (preferred for production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paiement manuel mobile money
# Numéros de réception affichés aux votants (Vodacom RDC / Orange RDC)
PAYMENT_MERCHANT_NAME=KINGABWA AWARDS
MPESA_MERCHANT_PHONE=+243000000002
ORANGE_MONEY_MERCHANT_PHONE=+243000000003

# Production example:
# CLIENT_URL=https://kingabwaawards2.netlify.app
